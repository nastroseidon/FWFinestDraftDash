# Postgres connection string.
# Local development uses the Docker container from the README.
# Production: Neon / Vercel Postgres / Supabase — any Postgres works.
#
# POSTGRES_URL, DATABASE_URL_UNPOOLED and POSTGRES_URL_NON_POOLING are also
# accepted, in that order, because Vercel's Neon integration sets those names.
DATABASE_URL=postgres://postgres:draftdash@localhost:55432/draftdash

# Signs the session cookie. Use a long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional. Emails the commissioner once every official run is in.
# Without these the notification is skipped and logged; nothing else changes.
RESEND_API_KEY=
COMMISSIONER_EMAIL=
NOTIFY_FROM=
